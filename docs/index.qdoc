/*
    PastViewer API reference landing page.
*/

/*!
    \page index.html
    \title PastViewer API Reference
    \brief C++ and QML API documentation generated from source.

    The reference is generated by the QDoc binary included with the Felgo
    macOS kit. Regular C++ topics live in implementation files, inline and
    template topics live in the header-only companion source, and QML topics
    live beside their declarations.

    \code
    cmake --build build --target pastviewer-docs
    \endcode

    \list
        \li \l {PastViewer C++ API}
        \li \l {PastViewer QML Types}
        \li \l {PastViewer GUI Items}
        \li \l {PastViewer Helpers}
        \li \l {PastViewer Dialogs}
    \endlist
*/

/*!
    \module PastViewer
    \title PastViewer C++ API
    \brief C++ classes, value types, and utility namespaces used by PastViewer.
*/

/*!
    \qmlmodule PastViewer
    \title PastViewer QML Types
    \brief Application views, controls, helpers, and C++ types exposed to QML.
*/

/*!
    \group pastviewer-gui-items
    \title PastViewer GUI Items
    \brief Reusable map markers, controls, and styled form widgets.
*/

/*!
    \group pastviewer-helpers
    \title PastViewer Helpers
    \brief Shared utilities for map animation, onboarding, and overlays.
*/

/*!
    \group pastviewer-dialogs
    \title PastViewer Dialogs
    \brief Modal dialogs for error reporting.
*/
